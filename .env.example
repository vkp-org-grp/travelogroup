# WordPress headless CMS (WPGraphQL plugin required on the WP install)
WORDPRESS_API_URL=https://cms.airlinesgroupbookings.com/graphql
WORDPRESS_HOSTNAME=cms.airlinesgroupbookings.com

# Optional: secret used by the WordPress webhook to trigger on-demand revalidation
REVALIDATE_SECRET=change-this-to-a-long-random-string
